# ---------------------------------------------------------------------------
# Zephyr (SmartBear's unified test management app) - the product installed on KAN.
#
# ONE bearer token. Generate it in Jira:
#   Settings -> General Settings -> Apps -> Zephyr API Access Tokens
#                                        -> Create access token
# Revoke via: Jira profile icon -> API Access Tokens -> Revoke.
# One token per user per Jira instance.
#
# This is a ZEPHYR token, not an Atlassian one. Test cases and their steps live in
# Zephyr's own store, not in Jira, so a Jira API token cannot write them.
# You do NOT need ZEPHYR_ACCESS_KEY / ZEPHYR_SECRET_KEY / ZEPHYR_ACCOUNT_ID - those
# belong to the legacy Zephyr Squad experience, which signed every request with a JWT.
# ---------------------------------------------------------------------------

# Used by scripts/push-to-zephyr.mjs
ZEPHYR_TOKEN=

# This tenant lives in the DE region. Pinning it skips region probing.
# Zephyr Cloud is region-sharded and a token is ONLY valid in its own region; the
# others answer 401 {"error":"Unknown token"}, which looks exactly like a bad token.
#   https://api.zephyrscale.smartbear.com/v2      US / default
#   https://eu.api.zephyrscale.smartbear.com/v2
#   https://de.api.zephyrscale.smartbear.com/v2   <- this tenant
#   https://au.api.zephyrscale.smartbear.com/v2
# Also how you point the script at Zephyr Essential, whose v2 surface is identical:
#   https://prod-api.zephyr4jiracloud.com/v2
ZEPHYR_BASE_URL=https://de.api.zephyrscale.smartbear.com/v2

# ---------------------------------------------------------------------------
# SmartBear MCP server (.mcp.json), for read-mostly Zephyr queries.
# Same token value as ZEPHYR_TOKEN above.
#
# NOTE: .mcp.json expands from the SHELL environment, not from this file. Export it:
#   PowerShell   $env:ZEPHYR_API_TOKEN = '<token>'
#   bash         export ZEPHYR_API_TOKEN='<token>'
# Set it permanently in Windows env vars if you want it to persist across sessions.
# ---------------------------------------------------------------------------
ZEPHYR_API_TOKEN=

# Toolshop target environment (local | staging | with-bugs)
TEST_ENV=local
